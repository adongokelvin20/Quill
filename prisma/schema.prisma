// Quill — Bringing intelligent education to life.
// Prisma schema.
//
// This schema works with BOTH SQLite (local dev) and PostgreSQL (Vercel).
// The provider is set automatically by the `scripts/setup-db.mjs` script
// based on the DATABASE_URL format:
//   - If DATABASE_URL starts with "file:" → SQLite (local dev)
//   - If DATABASE_URL starts with "postgres:" → PostgreSQL (Vercel)
//
// For Vercel deployment, the build command in vercel.json runs the setup script
// which sets the correct provider before prisma generate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
