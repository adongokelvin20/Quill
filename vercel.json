{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/quill/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/quill/export/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/quill/img/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/quill/image/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/quill/research/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/auth/[...nextauth]/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/auth/signup/route.ts": {
      "maxDuration": 30
    }
  },
  "buildCommand": "prisma generate && prisma db push && next build && cp .z-ai-config .next/standalone/ 2>/dev/null; true"
}
